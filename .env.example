# The product's root domain. Everything domain-bearing below is derived from it with
# ${CENTRAL_DOMAIN} (Laravel and Docker Compose both expand it; README "Environment").
CENTRAL_DOMAIN=brainyclan.com

APP_NAME="Brainy Clan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Public website (landing page, /support, legal pages...). Production: WEBSITE_URL=https://${CENTRAL_DOMAIN}
# and WEBSITE_HOST=${CENTRAL_DOMAIN} (host routing). Empty WEBSITE_HOST = every page on any host (dev).
WEBSITE_URL="${APP_URL}"
WEBSITE_HOST=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=brainy_clan
DB_USERNAME=brainy
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dev mail: Mailpit (http://localhost:8025) by default. To see mails in a Mailtrap sandbox inbox
# instead, set its SMTP credentials here (README "Emails"): MAIL_HOST=sandbox.smtp.mailtrap.io,
# MAIL_PORT=2525, MAIL_USERNAME/MAIL_PASSWORD from Mailtrap → Sandboxes → SMTP. Then
# `php artisan config:cache`, `docker compose restart horizon` and `php artisan mail:preview you@example.com`.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@${CENTRAL_DOMAIN}"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OPcache timestamp checks (see README "Performance"). 0 = fast on a Windows-drive bind mount,
# but run `docker compose restart app horizon` after changing PHP code.
# PHP_OPCACHE_VALIDATE_TIMESTAMPS=0

# Social sign-in (README "Google and Facebook sign-in - setup"). Run `php artisan config:cache` after changing.
# Google: OAuth client IDs whose ID tokens we accept (aud). Web is required; iOS/Android optional.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
# Facebook: Meta for Developers app ID + app secret.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# FACEBOOK_GRAPH_VERSION=v23.0
# Sign in with Apple (README "Sign in with Apple - setup"): accepted identity-token audiences,
# comma-separated: the iOS bundle ID and (for web sign-in) the Services ID.
# Web sign-in: append the Services ID, e.g. APPLE_CLIENT_IDS=app.brainyclan,app.brainyclan.web
APPLE_CLIENT_IDS=app.brainyclan
# Apple token revocation on account deletion / unlink (README "Sign in with Apple - setup", step 5):
# Team ID, the Sign in with Apple key's Key ID and the .p8 contents (one line with \n escapes is fine).
# Missing values: revocation is skipped (logged); sign-in still works.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# AI batch generator (README "AI batch generator"). Laravel AI SDK, provider Anthropic.
# Never commit a real key. Run `php artisan config:cache` and `docker compose restart app horizon` after changing.
ANTHROPIC_API_KEY=
# CONTENT_AI_MODEL=claude-sonnet-5-5
# CONTENT_AI_MAX_TOKENS=20000
# CONTENT_AI_TIMEOUT=300

# RevenueCat (B8): webhook Authorization header is "Bearer <secret>"; set the same value in the RevenueCat dashboard.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT=family
# RevenueCat REST API v1 secret key (Project settings → API keys → Secret API keys, starts with "sk_").
# Optional: enables POST /family/subscription/sync and lets the hourly reconciliation re-check RevenueCat.
# Server side only — never put it in the app.
REVENUECAT_API_KEY=
# REVENUECAT_API_URL=https://api.revenuecat.com/v1
# Minutes after expiry before the reconciliation expires a subscription that got no EXPIRATION webhook.
# REVENUECAT_RECONCILE_AFTER_MINUTES=60

# Paddle web checkout (B10, README "Web checkout (Paddle) — setup"). Empty keys = "coming soon".
# sandbox (https://sandbox-api.paddle.com) or production (https://api.paddle.com).
PADDLE_ENVIRONMENT=sandbox
# Server-side API key (Developer tools → Authentication). Never in the app or website.
PADDLE_API_KEY=
# Secret key of the webhook destination for /api/v1/webhooks/paddle (Developer tools → Notifications).
PADDLE_WEBHOOK_SECRET=
# Price ids (pri_…) of the Family plan prices.
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_SEMIANNUAL=
PADDLE_PRICE_ANNUAL=
# Hosted checkout link (Checkout → Hosted checkouts, https://…/checkout/hsc_…). Without it the
# default payment link must be https://<website>/subscribe/pay and PADDLE_CLIENT_TOKEN is needed.
PADDLE_HOSTED_CHECKOUT_URL=
PADDLE_CLIENT_TOKEN=
# PADDLE_GRACE_DAYS=30
# Store countries (ISO alpha-3, comma-separated) where the app may link to web checkout. Empty = none.
WEB_CHECKOUT_LINK_STOREFRONTS=

# AdMob rewarded-ad server-side verification (no key needed: Google's public keys are fetched and cached).
# ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
# AdMob publisher id (AdMob → Settings → Account information), served in /app-ads.txt on the website.
ADMOB_PUBLISHER_ID=

# Expo push notifications. No key needed; set an access token only if "Enhanced push security" is on in Expo.
EXPO_ACCESS_TOKEN=

# Legal pages (B9): keep true until a lawyer reviewed the terms and privacy policy
LEGAL_DRAFT=true
# Support address (website, emails) and privacy contact. Unset = support@${CENTRAL_DOMAIN}.
# LEGAL_SUPPORT_EMAIL="support@${CENTRAL_DOMAIN}"
# LEGAL_CONTACT_EMAIL="support@${CENTRAL_DOMAIN}"

# Monitoring (B11, README "Monitoring"): token for GET /api/v1/health/deep (header X-Health-Token);
# empty = the deep check answers 404. Alerts (Horizon long waits, failed jobs) are mailed to
# OPS_ALERT_EMAIL (unset = support@${CENTRAL_DOMAIN}; locally Mailpit) and optionally posted to a webhook.
HEALTH_DEEP_TOKEN=
# OPS_ALERT_EMAIL=
OPS_ALERT_WEBHOOK_URL=

# Sentry error monitoring (empty = off)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
