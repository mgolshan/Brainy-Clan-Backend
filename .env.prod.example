# Brainy Clan - PRODUCTION environment (docker-compose.prod.yml, docs/DEPLOY.md).
# Copy to .env.prod on the server (chmod 600, never commit it) and replace every CHANGE_ME.
# Generate secrets with: openssl rand -base64 32   (APP_KEY: see DEPLOY.md step 7)

# --- Domain / HTTPS (Caddy) -----------------------------------------------------------------
API_DOMAIN=api.brainyclan.app
ACME_EMAIL=CHANGE_ME@brainyclan.app
APP_IMAGE_TAG=latest

# --- Laravel --------------------------------------------------------------------------------
APP_NAME="Brainy Clan"
APP_ENV=production
APP_DEBUG=false
APP_KEY=CHANGE_ME
APP_URL=https://api.brainyclan.app
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12
# Browser origins allowed to call the API (comma separated). Native apps need none; add the Expo web
# build's URL here if you host one. Empty = no cross-origin browser access.
CORS_ALLOWED_ORIGINS=

# --- Database (MySQL container "mysql") ------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=brainy_clan
DB_USERNAME=brainy
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# --- Redis (cache, sessions, queues, Horizon) ------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis

# --- Mail (account deletion links; any SMTP provider, e.g. Postmark, Mailgun, SES) ------------
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@brainyclan.app
MAIL_FROM_NAME="Brainy Clan"

# --- Legal (B9) -------------------------------------------------------------------------------
# Keep true until a lawyer has reviewed the terms and privacy policy.
LEGAL_DRAFT=true
LEGAL_COMPANY_NAME=CHANGE_ME
LEGAL_CONTACT_EMAIL=privacy@brainyclan.app
LEGAL_POSTAL_ADDRESS=CHANGE_ME
LEGAL_PRIVACY_OFFICER=CHANGE_ME

# --- Sentry (error monitoring; empty = off) -------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Sign-in providers (README "Google and Facebook sign-in", "Sign in with Apple") ----------
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_IDS=app.brainyclan
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Billing, ads, push (README "Subscriptions, rewarded ads and push") ----------------------
REVENUECAT_WEBHOOK_SECRET=CHANGE_ME
REVENUECAT_ENTITLEMENT=family
REVENUECAT_API_KEY=
EXPO_ACCESS_TOKEN=

# --- AI content generator (README "AI batch generator") -------------------------------------
ANTHROPIC_API_KEY=

# --- Backups (docker/backup, DEPLOY.md "Backups and restore") --------------------------------
# Passphrase for the AES-256 encryption of every dump. Store a copy OUTSIDE the server
# (password manager): without it no backup can be restored.
BACKUP_PASSPHRASE=CHANGE_ME
BACKUP_RETENTION_DAYS=14
BACKUP_CRON="30 3 * * *"
# rclone remote "storagebox" = Hetzner Storage Box over SFTP (or use an S3 remote instead).
BACKUP_RCLONE_REMOTE=storagebox:brainy-clan-backups
RCLONE_CONFIG_STORAGEBOX_TYPE=sftp
RCLONE_CONFIG_STORAGEBOX_HOST=CHANGE_ME.your-storagebox.de
RCLONE_CONFIG_STORAGEBOX_PORT=23
RCLONE_CONFIG_STORAGEBOX_USER=CHANGE_ME
# Obscured password: docker compose -f docker-compose.prod.yml run --rm backup rclone obscure 'the-password'
RCLONE_CONFIG_STORAGEBOX_PASS=CHANGE_ME
